datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// User role classifications for RBAC
enum Role {
  SUPER_ADMIN
  ADMIN
  HR_MANAGER
  EMPLOYEE
  USER
}

// Account operational status
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
  ON_LEAVE
}

enum JobApplicationStatus {
  SUBMITTED
  SHORTLISTED
  INTERVIEW_SCHEDULED
  HIRED
  REJECTED
}

enum MediaType {
  FILE
  FOLDER
}

enum ContactStatus {
  PENDING
  CONTACTED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// Central User model for credentials & dashboard log-in
model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  avatar    String?
  role      Role       @default(USER)
  status    UserStatus @default(ACTIVE)
  password  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Link: A user optionally has an Employee profile if they are part of staff
  employee  Employee?
  invoices  Invoice[]
}

// Department Master Model
model Department {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// Designation Master Model
model Designation {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// Employment Type Master Model (e.g. Full-Time, Part-Time, Contract, Intern)
model EmploymentType {
  id          String     @id @default(uuid())
  name        String     @unique
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// Employment Status Master Model (e.g. Active, Probation, Inactive, Suspended)
model EmploymentStatus {
  id          String     @id @default(uuid())
  name        String     @unique
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// Employee Profile model (HRM core data)
model Employee {
  id                 String                 @id @default(uuid())
  userId             String?                @unique // Optional connection to User for system access
  user               User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  employeeId         String                 @unique // Generated staff ID, e.g. "EMP-2026-0001"
  photo              String?                // URL to uploaded staff photo
  name               String
  email              String                 @unique // Work or personal email
  phone              String?
  
  // Master references
  departmentId       String
  department         Department             @relation(fields: [departmentId], references: [id])
  designationId      String
  designation        Designation            @relation(fields: [designationId], references: [id])
  employmentTypeId   String
  employmentType     EmploymentType         @relation(fields: [employmentTypeId], references: [id])
  employmentStatusId String
  employmentStatus   EmploymentStatus       @relation(fields: [employmentStatusId], references: [id])
  
  joiningDate        DateTime               @default(now())
  
  // Self-relation: manager assignment
  managerId          String?
  manager            Employee?              @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates       Employee[]             @relation("EmployeeManager")
  
  // HR notes (internal use, hidden from the Employee view)
  hrNotes            String?
  
  // Relationships
  documents          EmployeeDocument[]
  leaveBalances      EmployeeLeaveBalance[]
  leaveApplications  LeaveApplication[]
  attendances        Attendance[]
  contactInquiries   ContactInquiry[]
  
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
}

// Employee Document Library model
model EmployeeDocument {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentName String   // e.g. "NID_Copy.pdf", "Passport.pdf"
  fileUrl      String   // Path/URL to document file
  fileType     String?  // MIME type
  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Leave Policy / Type Master Model (Casual Leave, Sick Leave, Paid Leave, etc.)
model LeaveType {
  id                 String                 @id @default(uuid())
  name               String                 @unique
  description        String?
  defaultDaysPerYear Int                    @default(10)
  balances           EmployeeLeaveBalance[]
  applications       LeaveApplication[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
}

// Employee Yearly Leave Balance Allocation Model
model EmployeeLeaveBalance {
  id          String    @id @default(uuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  year        Int
  totalDays   Int
  usedDays    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId, year])
}

// Leave Application / Request Model
model LeaveApplication {
  id              String      @id @default(uuid())
  employeeId      String
  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId     String
  leaveType       LeaveType   @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  startDate       DateTime
  endDate         DateTime
  totalDays       Int
  reason          String
  status          LeaveStatus @default(PENDING)
  approvedById    String?
  rejectionReason String?
  appliedAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// Attendance Policy / Shift Work Hours Configuration Model
model AttendancePolicy {
  id                   String   @id @default(uuid())
  workStartTime        String   @default("09:00") // 24-hr HH:mm
  workEndTime          String   @default("18:00") // 24-hr HH:mm
  lateGraceMinutes     Int      @default(15)
  earlyOutGraceMinutes Int      @default(15)
  halfDayHours         Float    @default(4.0)
  updatedAt            DateTime @updatedAt
}

// Attendance Check-In / Check-Out Log Model
model Attendance {
  id                   String           @id @default(uuid())
  employeeId           String
  employee             Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date                 DateTime         // Normalized date (00:00:00)
  checkInTime          DateTime
  checkOutTime         DateTime?
  status               AttendanceStatus @default(PRESENT)
  isLate               Boolean          @default(false)
  isEarlyOut           Boolean          @default(false)
  workHours            Float?
  ipAddress            String?
  checkInLatitude      Float?
  checkInLongitude     Float?
  checkInLocationName  String?
  checkOutLatitude     Float?
  checkOutLongitude    Float?
  checkOutLocationName String?
  remarks              String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([employeeId, date])
}

// Recruitment Job Post Model
model JobPost {
  id               String           @id @default(uuid())
  title            String
  slug             String           @unique
  vacancies        Int              @default(1)
  officeTime       String?          // e.g. "09:00 AM - 06:00 PM"
  location         String           // e.g. "Dhaka, Bangladesh"
  jobType          String           // e.g. "Full-time", "Part-time", "Contract"
  workMode         String           // e.g. "On-site", "Hybrid", "Remote"
  deadline         DateTime         // Expiration date
  description      String           // Rich HTML overview
  responsibilities String           // Rich HTML content
  benefits         String?          // Rich HTML perks & benefits
  customQuestions  Json?            // Array of custom questions: [{ id, questionText, required }]
  isPublished      Boolean          @default(true)
  applications     JobApplication[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

// Job Application Model
model JobApplication {
  id              String               @id @default(uuid())
  jobPostId       String
  jobPost         JobPost              @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  applicantName   String
  applicantEmail  String
  applicantPhone  String
  experienceYears String?              // e.g. "3 Years"
  currentCompany  String?
  expectedSalary  String?
  resumeUrl       String               // Path/URL to uploaded resume file
  coverLetter     String?
  answers         Json?                // Array of Q&A responses: [{ questionText, answerText }]
  status          JobApplicationStatus @default(SUBMITTED)
  hrNotes         String?
  appliedAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([jobPostId, applicantEmail])
}

// Invoice / Money Receipt Master Model
model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique // e.g. "RSTMYTG-979066" or "RST-2026-0001"
  clientName    String
  clientPhone   String
  clientEmail   String?
  clientAddress String?
  invoiceDate   DateTime      @default(now())
  dueDate       DateTime?
  paymentTerms  String        @default("Advanced") // e.g. "Advanced", "Full Payment", "Partial", "Due"
  subTotal      Float
  discount      Float         @default(0)
  totalAmount   Float
  amountPaid    Float         @default(0)
  balanceDue    Float
  notes         String?       @default("Booking Money are not Re-fundable")
  
  // Creator relation
  createdById   String?
  createdBy     User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  creatorName   String?       // Cached employee/creator name for signature block
  items         InvoiceItem[]
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// Invoice Line Item Model
model InvoiceItem {
  id              String   @id @default(uuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemDescription String   // e.g. "Malaysia & Thailand Tour - 7Nights & 8Days..."
  subDescription  String?  // e.g. "Room - (Single Occupancy)"
  quantity        Int      @default(1)
  rate            Float    // Unit Price in BDT
  amount          Float    // quantity * rate
  createdAt       DateTime @default(now())
}

// Tour Location Master Model
model TourLocation {
  id          String        @id @default(uuid())
  country     String        @unique
  slug        String        @unique
  image       String?
  description String?
  isFeatured  Boolean       @default(true)
  packages    TourPackage[]
  gallery     GalleryItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// Tour Package Master Model
model TourPackage {
  id               String             @id @default(uuid())
  title            String
  slug             String             @unique
  image            String?
  featuredImage    String?
  galleryImages    String[]
  price            Float
  discountPrice    Float?
  duration         String             // e.g. "5 Days / 4 Nights"
  locationId       String?
  location         TourLocation?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  locationName     String?            // Fallback location label
  hotelRating      Int                @default(4)
  rating           Float              @default(4.8)
  description      String?
  shortDescription String?
  additionalInfo   String?
  transportation   String[]
  inclusions       String[]
  exclusions       String[]
  isFeatured       Boolean            @default(true)
  isPublished      Boolean            @default(true)
  itinerary        PackageItinerary[]
  hotels           PackageHotel[]
  gallery          GalleryItem[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

// Package Daily Itinerary Breakdown Model
model PackageItinerary {
  id          String      @id @default(uuid())
  packageId   String
  package     TourPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  dayName     String      // e.g. "Day 01"
  title       String      // e.g. "Arrival & Hotel Check-in"
  description String
  image       String?
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// Package Hotel Stay Configuration Model
model PackageHotel {
  id        String      @id @default(uuid())
  packageId String
  package   TourPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  city      String      // e.g. "Cox's Bazar"
  hotelName String      // e.g. "Sayeman Beach Resort"
  roomType  String?     // e.g. "Deluxe Sea View"
  rating    Int         @default(4)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

// Traveler Testimonial / Review Model
model Testimonial {
  id              String   @id @default(uuid())
  name            String
  country         String   // Traveler origin or location tag
  feedback        String
  rating          Int      @default(5)
  backgroundImage String?
  avatarImage     String?
  isPublished     Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Media Management / File Manager Model
model MediaItem {
  id         String    @id @default(uuid())
  name       String
  type       MediaType @default(FILE)
  url        String?
  folderPath String    @default("") // Empty string for root folder
  size       Int       @default(0)
  mimeType   String?
  width      Int?
  height     Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([folderPath])
}

// Contact Request / Inquiry Form Model
model ContactInquiry {
  id           String        @id @default(uuid())
  name         String
  email        String
  phone        String
  message      String
  destination  String?
  travelDate   String?
  guestCount   Int?          @default(1)
  status       ContactStatus @default(PENDING)
  notes        String?
  assignedToId String?
  assignedTo   Employee?     @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// Newsletter Subscriber Model
model NewsletterSubscriber {
  id           String   @id @default(uuid())
  name         String?
  email        String   @unique
  isActive     Boolean  @default(true)
  subscribedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Client / Traveler Image Gallery Model
model GalleryItem {
  id          String        @id @default(uuid())
  title       String
  caption     String?
  imageUrl    String
  destination String?
  locationId  String?
  location    TourLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  packageId   String?
  package     TourPackage?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  isPublished Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}
